{
  "uid": "eventpulse-overview",
  "title": "EventPulse Overview",
  "tags": ["eventpulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Events ingested / s",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(eventpulse_events_ingested_total[1m]))" }]
    },
    {
      "id": 2, "type": "stat", "title": "Delivery success ratio (5m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }, "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(eventpulse_deliveries_total{status=\"success\"}[5m])) / clamp_min(sum(rate(eventpulse_deliveries_total[5m])), 1e-9)" }]
    },
    {
      "id": 3, "type": "stat", "title": "Queue backlog",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 500 }, { "color": "red", "value": 1000 }
          ] }
        }, "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "max(eventpulse_queue_backlog_depth)" }]
    },
    {
      "id": 4, "type": "stat", "title": "Worker instances up",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(up{job=~\".*worker.*\"})" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Events ingested / s",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "ingested", "expr": "sum(rate(eventpulse_events_ingested_total[1m]))" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Deliveries / s by terminal status",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [{ "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (rate(eventpulse_deliveries_total[1m]))" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Webhook dispatch latency",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(eventpulse_webhook_dispatch_duration_seconds_bucket[2m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(eventpulse_webhook_dispatch_duration_seconds_bucket[2m])))" },
        { "refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(eventpulse_webhook_dispatch_duration_seconds_bucket[2m])))" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Queue backlog depth & retries / s",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "retries/s" }, "properties": [{ "id": "custom.axisPlacement", "value": "right" }, { "id": "unit", "value": "ops" }] }
        ]
      },
      "targets": [
        { "refId": "A", "legendFormat": "backlog", "expr": "max(eventpulse_queue_backlog_depth)" },
        { "refId": "B", "legendFormat": "retries/s", "expr": "sum(rate(eventpulse_delivery_retries_total[1m]))" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "API requests / s by route",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{route}} {{code}}", "expr": "sum by (route, code) (rate(eventpulse_http_requests_total[1m]))" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "API p95 latency by route",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{route}}", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(eventpulse_http_request_duration_seconds_bucket[2m])))" }]
    }
  ]
}
