# Copy to .env to override docker-compose defaults.

POSTGRES_USER=eventpulse
POSTGRES_PASSWORD=eventpulse
POSTGRES_DB=eventpulse

# Host ports (change if they clash with something already running)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8080
FRONTEND_HOST_PORT=3100
GRAFANA_HOST_PORT=3101
PROMETHEUS_HOST_PORT=9091

# Optional bearer token required for /v1/* (the dashboard proxy forwards it).
API_KEY=

# Worker tuning
WORKER_CONCURRENCY=32
DISPATCH_TIMEOUT=5s
MAX_ATTEMPTS=5
BASE_BACKOFF=5s
# Set to false in production to block webhooks to private/loopback addresses (SSRF protection).
ALLOW_PRIVATE_TARGETS=true

# Demo receiver (docker compose --profile demo up receiver)
RECEIVER_SECRET=
RECEIVER_FAIL_PERCENT=30

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# For running the Go binaries outside Docker:
# DATABASE_URL=postgres://eventpulse:eventpulse@localhost:5433/eventpulse?sslmode=disable
# REDIS_URL=redis://localhost:6380/0
